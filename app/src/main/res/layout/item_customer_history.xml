<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E1AFD1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Baris 1: Nama paket + status ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvItemPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/tvItemStatus"
                android:layout_marginEnd="8dp"
                android:text="9 Kartu Deep Reading"
                android:textColor="#7469B6"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_status_rounded"
                android:backgroundTint="#F3E5F5"
                android:paddingHorizontal="8dp"
                android:text="DONE"
                android:textColor="#AD88C6"
                android:textSize="10sp" />
        </RelativeLayout>

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12 April 2026"
            android:textColor="#80251819"
            android:textSize="11sp" />

        <!-- Reader -->
        <TextView
            android:id="@+id/tvItemReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Reader: -"
            android:textColor="#7469B6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#FFE6E6" />

        <!-- Pertanyaan & jawaban -->
        <TextView
            android:id="@+id/tvItemQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q: Bagaimana karir saya?"
            android:textColor="#251819"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvItemAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A: Belum ada jawaban dari Reader."
            android:textColor="#AD88C6"
            android:textSize="12sp" />

        <!-- Tombol aksi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelOrder"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Batalkan Pesanan"
            android:textColor="#E57373"
            android:textSize="11sp"
            android:visibility="gone"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTulisUlasan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✍️ Tulis Ulasan"
            android:textColor="#7469B6"
            android:textSize="11sp"
            android:visibility="gone"
            app:backgroundTint="#F3E5F5"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareRamalan"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔗 Bagikan Ramalan"
            android:textColor="#7469B6"
            android:textSize="11sp"
            android:visibility="gone"
            app:backgroundTint="#F3E5F5"
            app:cornerRadius="8dp" />

        <!-- Ulasan terkirim -->
        <LinearLayout
            android:id="@+id/layoutUlasanTerkirim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_rounded"
            android:backgroundTint="#F8F0FF"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Ulasan Kamu"
                android:textColor="#7469B6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIsiRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="★★★★★"
                android:textColor="#FFB300"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvIsiUlasan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#251819"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- QR TICKET — tampil untuk semua status kecuali CANCELLED -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutQrTicket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_border_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_rounded"
                android:backgroundTint="#7469B6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="🎫  TIKET SESI"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- QR Image -->
            <ImageView
                android:id="@+id/imgQrCode"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                android:contentDescription="QR Code Booking" />

            <!-- Booking ID -->
            <TextView
                android:id="@+id/tvQrBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="#AD88C6"
                android:textSize="10sp" />

            <!-- Tombol simpan ke galeri -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveQr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                android:text="💾  Simpan QR"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#AD88C6"
                app:cornerRadius="100dp" />

        </LinearLayout>
        <!-- ═══════════════════════════════════════════ -->

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>