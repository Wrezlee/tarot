<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE6E6"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarReader"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#7469B6"
        app:titleTextColor="#FFFFFF"
        app:popupTheme="@style/ThemeOverlay.Material3.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HOME FRAGMENT (NestedScrollView langsung, bukan FrameLayout) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReaderHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbarReader"
        app:layout_constraintBottom_toTopOf="@+id/navbarReader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvReaderGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:text="Dashboard Reader"
                android:textColor="#7469B6"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat datang kembali"
                android:textColor="#AD88C6"
                android:textSize="13sp" />

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#7469B6"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">
                <RelativeLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:text="STATUS SAAT INI"
                            android:textSize="10sp"
                            android:textColor="#E1AFD1"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:text="Online &amp; Active"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="true" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:padding="16dp" android:orientation="vertical"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="ANTREAN" android:textSize="10sp"
                            android:textColor="#AD88C6" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvPendingCount" android:text="0"
                            android:textStyle="bold" android:textSize="18sp" android:textColor="#7469B6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:padding="16dp" android:orientation="vertical"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="SELESAI" android:textSize="10sp"
                            android:textColor="#AD88C6" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvCompletedCount" android:text="0"
                            android:textStyle="bold" android:textSize="18sp" android:textColor="#7469B6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Antrean Aktif -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Antrean Aktif"
                android:textColor="#7469B6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Booking berikutnya yang menunggu"
                android:textColor="#AD88C6"
                android:textSize="11sp"
                android:textStyle="italic" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:strokeColor="#E1AFD1"
                app:strokeWidth="1dp">
                <LinearLayout android:padding="16dp" android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvNextCustomerName"
                            android:text="Belum Ada Antrean"
                            android:textColor="#7469B6"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:id="@+id/tvNextBookingTime"
                            android:layout_alignParentEnd="true"
                            android:text="--:--"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#7469B6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tvNextBookingDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#AD88C6" />
                    <TextView
                        android:id="@+id/tvNextPackageName"
                        android:layout_marginTop="4dp"
                        android:text="Siap melayani sesi baru"
                        android:textSize="12sp"
                        android:textColor="#AD88C6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartReading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Mulai Ramalan"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#7469B6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kalender Booking -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Kalender Booking Minggu Ini"
                android:textColor="#7469B6"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Semua booking yang terjadwal minggu ini"
                android:textColor="#AD88C6"
                android:textSize="11sp"
                android:textStyle="italic" />
            <LinearLayout
                android:id="@+id/containerCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <View android:layout_width="match_parent" android:layout_height="40dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FRAGMENT CONTAINER untuk History & Profile -->
    <FrameLayout
        android:id="@+id/containerReader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/toolbarReader"
        app:layout_constraintBottom_toTopOf="@+id/navbarReader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navbarReader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="#207469B6"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/CustomIndicator"
        app:menu="@menu/menu_nav_reader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>