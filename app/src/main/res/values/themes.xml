<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Base.Theme.Tarot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#7469B6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F3E5F5</item>

        <item name="android:windowBackground">#FFE6E6</item>

        <item name="android:statusBarColor">#7469B6</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:editTextColor">#251819</item>
        <item name="android:textColorPrimary">#251819</item>

        <item name="searchViewStyle">@style/TarotSearchViewStyle</item>
    </style>

    <style name="TarotSearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@null</item>
        <item name="android:editTextColor">#251819</item>
        <item name="android:textColor">#251819</item>
        <item name="android:textColorHint">#AD88C6</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="TarotSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">#251819</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TarotSpinnerItemStyle" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">#251819</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="TarotSpinnerDropDownStyle" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">#251819</item>
        <item name="android:textSize">13sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#F3E5F5</item>
        <item name="android:width">44dp</item>
        <item name="android:height">44dp</item>
    </style>

    <style name="Theme.Tarot" parent="Base.Theme.Tarot" />

    <style name="RoundedSquare" parent="">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="CircleAppearance" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>